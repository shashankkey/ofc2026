# ============================================
# Aternity OData API Configuration
# ============================================
ATERNITY_BASE_URL=https://your-aternity-server.com/aternity.odata/v2
ATERNITY_USERNAME=your_aternity_username
ATERNITY_PASSWORD=your_aternity_api_password

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTIC_URL=https://your-elasticsearch:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=your_elastic_password
# Set to "true" if using self-signed certs, "false" to skip verification
ELASTIC_VERIFY_SSL=true

# ============================================
# Ingestion Settings
# ============================================
# How many hours of data to pull each cron run (default: 2)
# Set to match your cron interval with some overlap for safety
LOOKBACK_HOURS=2
# Batch size for Elasticsearch bulk API
BULK_BATCH_SIZE=500
# Data stream name
DATA_STREAM_NAME=metrics-aternity.business_activities-default
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
