# ============================================================================
# Salesforce Status API Client
# ============================================================================
class SalesforceStatusClient:
    """Fetches instance status from the Salesforce Trust Status API."""

    def __init__(self, base_url: str):
        self.base_url = base_url.rstrip("/")
        self.session = requests.Session()
        self.session.headers.update({"Accept": "application/json"})

    def get_alias_status(self, alias: str) -> dict:
        """
        GET /instanceAliases/{alias}/status
        Returns instance status with Incidents[] and Maintenances[].
        """
        url = f"{self.base_url}/instanceAliases/{alias}/status"
        log.info("Fetching: %s", url)
        resp = self.session.get(url, timeout=30)
        resp.raise_for_status()
        data = resp.json()

        # API returns an array even for a single alias
        if isinstance(data, list):
            if not data:
                raise ValueError(f"No instance found for alias '{alias}'")
            data = data[0]

        log.info(
            "Instance=%s | status=%s | incidents=%d | maintenances=%d",
            data.get("key", "?"), data.get("status", "?"),
            len(data.get("Incidents", [])), len(data.get("Maintenances", [])),
        )
        return data

    def get_product_status(self, product_id: str) -> dict:
        """
        GET /v1/products/{product_id}
        Returns the full product object including all instances and their incidents.
        """
        url = f"{self.base_url}/products/{product_id}"
        log.info("Fetching MuleSoft product status: %s", url)
        resp = self.session.get(url, timeout=30)
        resp.raise_for_status()
        data = resp.json()
 
        instances = data.get("Instances", [])
        active_instances = [i for i in instances if i.get("isActive", True)]
        total_incidents = sum(len(i.get("Incidents", [])) for i in active_instances)
        degraded = [i["key"] for i in active_instances if i.get("status", "OK") != "OK"]
 
        log.info(
            "MuleSoft product=%s | active_instances=%d | total_incidents=%d | degraded=%s",
            data.get("key", "?"),
            len(active_instances),
            total_incidents,
            degraded if degraded else "none",
        )
        return data
# ============================================================================
# Elasticsearch Ingestor
# ============================================================================
class ElasticIngestor:
    """Handles index creation and document indexing."""

    def __init__(self):
        kwargs = {
            "hosts": [ES_HOST],
            "basic_auth": (ES_USER, ES_PASSWORD),
            "request_timeout": 30,
        }
        if not ES_VERIFY_SSL:
            urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
            kwargs["verify_certs"] = False
            kwargs["ssl_show_warn"] = False

        self.es = Elasticsearch(**kwargs)
        info = self.es.info()
        log.info("Connected to ES %s", info["version"]["number"])

    def ensure_indices(self):
        """Create indices with mappings if they don't already exist."""
        for idx, mapping in [(INCIDENT_INDEX, INCIDENT_MAPPING),
                             (MAINTENANCE_INDEX, MAINTENANCE_MAPPING)]:
            if not self.es.indices.exists(index=idx):
                self.es.indices.create(index=idx, body=mapping)
                log.info("Created index: %s", idx)

    def index_doc(self, index: str, doc_id: str, doc: dict):
        """Index a document using the Salesforce id as the ES _id."""
        self.es.index(index=index, id=doc_id, document=doc)


# ============================================================================
# Orchestration
# ============================================================================
def run_once(sf: SalesforceStatusClient, es: ElasticIngestor | None, dry_run: bool = False):
    """Single poll cycle: fetch from API → index into ES."""

    status = sf.get_alias_status(SF_DOMAIN_ALIAS)

    instance_key    = status.get("key", "unknown")
    instance_status = status.get("status", "UNKNOWN")
    incidents       = status.get("Incidents", [])
    maintenances    = status.get("Maintenances", [])
    now             = datetime.now(timezone.utc).isoformat()

    # -- Dry-run --
    if dry_run:
        print(f"\n{'='*60}")
        print(f"  Instance:     {instance_key}")
        print(f"  Status:       {instance_status}")
        print(f"  Incidents:    {len(incidents)}")
        print(f"  Maintenances: {len(maintenances)}")
        print(f"{'='*60}")
        if incidents:
            print("\n--- Incidents ---")
            print(json.dumps(incidents, indent=2, default=str))
        if maintenances:
            print("\n--- Maintenances ---")
            print(json.dumps(maintenances, indent=2, default=str))
        if not incidents and not maintenances:
            print("\n  ✓ No active incidents or maintenances.")
        return

    # -- Index incidents --
    for inc in incidents:
        doc = {
            "@timestamp":            now,
            "domain_alias":          SF_DOMAIN_ALIAS,
            "instance_key":          instance_key,
            "instance_status":       instance_status,
            "id":                    str(inc.get("id", "")),
            "externalId":            inc.get("externalId"),
            "status":                inc.get("status"),
            "type":                  inc.get("type"),
            "message":               inc.get("message"),
            "affectsAll":            inc.get("affectsAll", False),
            "isCore":                inc.get("isCore", False),
            "additionalInformation": inc.get("additionalInformation"),
            "serviceKeys":           inc.get("serviceKeys", []),
            "instanceKeys":          inc.get("instanceKeys", []),
            "createdAt":             inc.get("createdAt"),
            "updatedAt":             inc.get("updatedAt"),
        }
        es.index_doc(INCIDENT_INDEX, doc["id"], doc)
        log.info("Indexed incident id=%s", doc["id"])

    # -- Index maintenances --
    for maint in maintenances:
        doc = {
            "@timestamp":              now,
            "domain_alias":            SF_DOMAIN_ALIAS,
            "instance_key":            instance_key,
            "instance_status":         instance_status,
            "id":                      str(maint.get("id", "")),
            "externalId":              maint.get("externalId"),
            "status":                  maint.get("status"),
            "type":                    maint.get("type"),
            "name":                    maint.get("name"),
            "message":                 maint.get("message"),
            "externalMaintenanceType": maint.get("externalMaintenanceType"),
            "releaseType":             maint.get("releaseType"),
            "substrate":               maint.get("substrate"),
            "affectsAll":              maint.get("affectsAll", False),
            "isCore":                  maint.get("isCore", False),
            "plannedStartTime":        maint.get("plannedStartTime"),
            "plannedEndTime":          maint.get("plannedEndTime"),
            "additionalInformation":   maint.get("additionalInformation"),
            "serviceKeys":             maint.get("serviceKeys", []),
            "instanceKeys":            maint.get("instanceKeys", []),
            "createdAt":               maint.get("createdAt"),
            "updatedAt":               maint.get("updatedAt"),
        }
        es.index_doc(MAINTENANCE_INDEX, doc["id"], doc)
        log.info("Indexed maintenance id=%s (%s)", doc["id"], doc.get("name", ""))

    log.info("Done. Indexed %d incident(s), %d maintenance(s).", len(incidents), len(maintenances))

def run_mulesoft_once(
    ms: MulesoftProductClient,
    es: ElasticIngestor | None,
    dry_run: bool = False,
):
    """
    Single MuleSoft poll cycle.
 
    For every active instance in the MuleSoft product response:
      1. Write an instance-health snapshot → mulesoft-instances index
         (_id = instance_key, so each poll overwrites the previous snapshot)
      2. For each incident on that instance:
         Write an incident doc → mulesoft-incidents index
         (_id = incident id, idempotent upsert)
 
    The product endpoint does not surface Maintenances at the instance level,
    so only Incidents are captured here.
    """
    product   = ms.get_product_status(MULESOFT_PRODUCT_ID)
    now       = datetime.now(timezone.utc).isoformat()
 
    product_key  = product.get("key",  "Mulesoft")
    product_name = product.get("name", "MuleSoft")
    instances    = product.get("Instances", [])
 
    # Filter to active instances only
    active_instances = [i for i in instances if i.get("isActive", True)]
 
    # -- Dry-run --
    if dry_run:
        total_incidents = sum(len(i.get("Incidents", [])) for i in active_instances)
        degraded = [(i["key"], i.get("status")) for i in active_instances if i.get("status") != "OK"]
 
        print(f"\n{'='*60}")
        print(f"  Product:          {product_name} ({product_key})")
        print(f"  Active instances: {len(active_instances)} / {len(instances)}")
        print(f"  Total incidents:  {total_incidents}")
        print(f"  Degraded:         {degraded if degraded else 'none'}")
        print(f"{'='*60}")
 
        for inst in active_instances:
            incidents = inst.get("Incidents", [])
            if incidents:
                print(f"\n  [{inst['key']}] status={inst.get('status')} — {len(incidents)} incident(s):")
                print(json.dumps(incidents, indent=4, default=str))
 
        if total_incidents == 0:
            print("\n  ✓ No active incidents across MuleSoft instances.")
        return
 
    # -- Index instance snapshots + per-instance incidents --
    total_incidents_indexed = 0
 
    for inst in active_instances:
        inst_key      = inst.get("key", "unknown")
        inst_status   = inst.get("status", "UNKNOWN")
        inst_incidents = inst.get("Incidents", [])
 
        # 1. Instance health snapshot (upserted by instance_key).
        #    Spread the full raw instance object so any new API fields are
        #    captured automatically, then overlay our computed/enrichment keys.
        #    "Incidents" is stripped — incidents are stored in their own index.
        instance_doc = {
            **{k: v for k, v in inst.items() if k != "Incidents"},
            "@timestamp":   now,
            "product_key":  product_key,
            "product_name": product_name,
            "instance_key": inst_key,   # explicit alias for clarity
            "incident_count": len(inst_incidents),
        }
        es.index_doc(MULESOFT_INSTANCE_INDEX, inst_key, instance_doc)
        log.debug("Upserted instance snapshot key=%s status=%s", inst_key, inst_status)
 
        # 2. Individual incident documents.
        #    Spread the full raw incident object, then overlay enrichment context
        #    (product + parent instance metadata) so Kibana queries need no joins.
        for inc in inst_incidents:
            inc_id = str(inc.get("id", ""))
            if not inc_id:
                log.warning("Skipping incident with no id on instance %s", inst_key)
                continue
 
            inc_doc = {
                **inc,                          # all raw incident fields, future-proof
                "@timestamp":           now,
                "product_key":          product_key,
                "product_name":         product_name,
                # parent instance context — prefixed to avoid collisions with
                # incident-level fields that share names (e.g. "status")
                "instance_key":         inst_key,
                "instance_status":      inst_status,
                "instance_location":    inst.get("location"),
                "instance_environment": inst.get("environment"),
                "instance_is_active":   inst.get("isActive", True),
            }
            es.index_doc(MULESOFT_INDEX, inc_id, inc_doc)
            log.info(
                "Indexed MuleSoft incident id=%s instance=%s status=%s",
                inc_id, inst_key, inc.get("status"),
            )
            total_incidents_indexed += 1
 
    log.info(
        "MuleSoft done. Snapshotted %d active instance(s), indexed %d incident(s).",
        len(active_instances),
        total_incidents_indexed,
    )
# ============================================================================
# CLI
# ============================================================================
def main():
    parser = argparse.ArgumentParser(
        description="Ingest Salesforce Status incidents & maintenances into Elasticsearch"
    )
    parser.add_argument("--dry-run", action="store_true", help="Fetch & print only, no ES writes")
    args = parser.parse_args()

    sf = SalesforceStatusClient(SF_BASE_URL)
    es = None

    if not args.dry_run:
        es = ElasticIngestor()
        es.ensure_indices()

    run_once(sf, es, dry_run=args.dry_run)


if __name__ == "__main__":
    main()
